APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_intelligence
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_PROVIDER=groq
GROQ_API_KEY=
