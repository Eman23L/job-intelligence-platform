APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_intelligence
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
REDIS_URL=redis://localhost:6379/0
QUEUE_ENABLED=false
QUEUE_NAME=default
RQ_RESULT_TTL_SECONDS=3600
RQ_FAILURE_TTL_SECONDS=86400
SCRAPE_TIMEOUT_SECONDS=600
APPLY_TIMEOUT_SECONDS=900
PLAYWRIGHT_STEP_TIMEOUT_MS=30000
PAGE_NAVIGATION_TIMEOUT_MS=60000

# Frontend only. Set this in Vercel to the deployed backend URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
